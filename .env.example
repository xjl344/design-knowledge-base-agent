# OpenAI / OpenAI-compatible API
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional local-compatible model backends. Keep final generation on LLM_MODEL;
# planner/grader can point to a local OpenAI-compatible server.
PLANNER_BACKEND=cloud
PLANNER_MODEL=
PLANNER_BASE_URL=
PLANNER_API_KEY=
GRADER_BACKEND=cloud
GRADER_MODEL=
GRADER_BASE_URL=
GRADER_API_KEY=
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=E:\AI-Infra\models\reranker\bge-reranker
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
RERANKER_USE_FP16=true

# Existing local embedding model (do not copy it into this project)
AI_INFRA_DIR=E:\AI-Infra
EMBEDDING_MODEL_PATH=E:\AI-Infra\models\embeddings\bge-m3
# Ingestion batch-embedding runs on GPU; retrieval query encoding on CPU.
# EMBEDDING_DEVICE=cuda keeps the GPU for ingest; RETRIEVAL_DEVICE=cpu keeps
# query-time encoding off the GPU. Use cpu for EMBEDDING_DEVICE only when no GPU.
EMBEDDING_DEVICE=cuda
RETRIEVAL_DEVICE=cpu
# batch=32 is ~7x faster than 1 on a 6GB GPU (~280 chunks/s, ~2.3GB peak VRAM).
# Lower to 8 if VRAM is tight; keep 1 only for troubleshooting.
EMBEDDING_BATCH_SIZE=32

# Chunking: F=fixed, R=recursive (current default), P=paragraph semantic,
# V=reserved vector-semantic strategy.
CHUNKING_STRATEGY=R
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SEMANTIC_SIMILARITY_THRESHOLD=0.72
SEMANTIC_MIN_CHUNK_SIZE=250
SEMANTIC_MAX_CHUNK_SIZE=1200

# Optional tuning
# Hybrid retrieval: original query top-k + LLM-decomposed facet sub-queries
# (sub-queries add only NEW sources missed by the original query).
RETRIEVER_TOP_K=10
RETRIEVER_DENSE_TOP_K=50
RETRIEVER_BM25_TOP_K=50
RETRIEVER_RERANK_TOP_K=20
RETRIEVER_UNION_MAX_CANDIDATES=200
RETRIEVER_EXPANSION_BM25_TOP_K=20
RETRIEVER_SOURCE_ROLE_PRIORITY=true
RETRIEVER_SEPARATE_ENTITIES=true
RETRIEVER_INDEPENDENT_BM25_QUERIES=false
RETRIEVER_BM25_MODE=conditional
RETRIEVER_MAX_ENTITY_BM25_QUERIES=3
RETRIEVER_ENTITY_BM25_TOP_K=20
RETRIEVER_SOURCE_CAP=2
RETRIEVER_RANKING_MODE=reranker_entity_rrf
RETRIEVER_ENTITY_GUARD=true
RETRIEVER_METADATA_WEIGHT=3.0
RETRIEVER_PARENT_WEIGHT=2.0
RETRIEVER_RERANK_WEIGHT=0.82
RETRIEVER_EXPLICIT_ENTITY_WEIGHT=0.10
RETRIEVER_EXPANDED_ENTITY_WEIGHT=0.03
RETRIEVER_RRF_WEIGHT=0.05
RRF_K=60
DENSE_WEIGHT=0.55
BM25_WEIGHT=0.45
RETRIEVER_SUBQUERY_TOP_K=5    # candidates per decomposed sub-query
RETRIEVER_NEW_SOURCE_CAP=2    # max chunks added per new source from sub-queries
# Decomposing the question into sub-queries costs one extra LLM call plus a
# retrieval per sub-query.  Measured on the reference machine it is the main
# reason retrieval takes 374 s/question instead of 129 s -- and an A/B found it
# is not a net win (@10 better, @20 worse, 42 vs 38 sources hit).  The R baseline
# quoted in the README was measured on the single-query path, so `false` also
# keeps the app and the published numbers on the same route.
QUERY_DECOMPOSE_ENABLED=false
WEB_SEARCH_MAX_RESULTS=3
# The model-call ceiling.  60 s is a deterministic wall, not service jitter: on
# the largest recorded contexts it timed out in 2-3 of 3 identical runs at
# exactly 60.0-62.5 s, which made `runs_comparable` permanently false -- no
# repetition count fixes a ceiling.  Raised so the stability gate measures the
# model rather than the timeout.
LLM_TIMEOUT_SECONDS=180
# Nested budgets must fit inside TOTAL_PIPELINE_TIMEOUT_SECONDS, otherwise the
# pipeline cancels first and these values can never take effect.
#
# ⚠️ They must also be large enough to *finish*.  Measured per question on the
# reference machine (2026-09-24):
#   single-query path (QUERY_DECOMPOSE_ENABLED=false)  129 s mean / 195 s max
#   multi-query path  (production)                     374 s mean / 1945 s max
# A 20 s budget failed every question with
# `工具 local_retrieval 执行超过 20 秒` -- the app could not retrieve at all.
# The values below fit the single-query path with margin.  Turning decomposition
# back on needs these raised past 900 and TOTAL_PIPELINE past 1200.
LOCAL_RETRIEVAL_TIMEOUT_SECONDS=300
# Hard deadline shared by embedding, dense, BM25, fusion and reranking.
LOCAL_RETRIEVAL_TOTAL_TIMEOUT_SECONDS=300
# NOTE: these three are currently referenced nowhere in the code.  They are kept
# for documentation; changing them has no effect.
EMBEDDING_TIMEOUT_SECONDS=10
DENSE_RETRIEVAL_TIMEOUT_SECONDS=8
BM25_TIMEOUT_SECONDS=5
RERANKER_TIMEOUT_SECONDS=10
PLANNER_TIMEOUT_SECONDS=15
TOTAL_PIPELINE_TIMEOUT_SECONDS=600
CANCEL_ON_TIMEOUT=true
OFFLINE_MODE=false
ALLOW_WEB_CACHE=true
MAX_RETRIEVAL_TASKS=3
MAX_WEB_QUERIES=3
GRADIO_SERVER_PORT=7860

# Agent planning, tools and runtime safeguards
AGENT_PLANNING_ENABLED=true
MAX_CONCURRENT_REQUESTS=2
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=2
PER_QUERY_TOKEN_LIMIT=10000
DAILY_TOKEN_LIMIT=1000000
LANGSMITH_SAMPLING_RATE=0.1
CHECKPOINT_DIR=.tmp/checkpoints

# LangSmith evaluation (optional; used by eval_langsmith.py)
# Get an API key at https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=design-knowledge-qa
