    {
      "question_id": "q17_ambiguous",
      "question": "设计儿童座椅时，座面高度应该怎么确定？",
      "snapshot_id": "2fbc7ddd75805006",
      "allowed_citations": [
        "L1",
        "L2",
        "L3",
