    {
      "question_id": "r17_cylinder_capacity",
      "question": "直筒杯内径65 mm、有效液高120 mm，按知识库公式估算理想容量，并说明为何不能直接当额定容量。",
      "snapshot_id": "c9c97ed4f80ae388",
      "allowed_citations": [
        "L1",
        "L2",
        "L3",
