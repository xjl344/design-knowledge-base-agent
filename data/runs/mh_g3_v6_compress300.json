    {
      "question_id": "mh04_percentile_derivation",
      "question": "依据 GB/T 26158—2010 的坐高百分位数据，推算儿童椅座高的合理区间，并说明应取哪个百分位及理由。",
      "snapshot_id": "5c9486adf612e421",
      "allowed_citations": [
        "L1",
        "L2",
